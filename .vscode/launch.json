{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run proxy via uvicorn",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--env-file",
                "environment.secret.txt"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}",
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}

